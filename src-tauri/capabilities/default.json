{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões da janela principal: só os commands do app.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-disk-info",
    "allow-last-scan",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-category-files",
    "allow-reveal",
    "allow-move-to-trash",
    "allow-empty-trash",
    "allow-docker-prune",
    "allow-old-downloads",
    "allow-largest-files",
    "allow-trash-caches",
    "allow-trash-items",
    "allow-restore-from-trash",
    "allow-purge-from-trash"
  ]
}
