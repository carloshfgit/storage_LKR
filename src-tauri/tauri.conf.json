{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "storage-looker",
  "version": "1.0.1",
  "identifier": "com.carloshf.storage-looker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Storage Looker",
        "width": 820,
        "height": 680,
        "minWidth": 560,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "desktop.template"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "Copyright © 2026 Carlos Costa",
    "license": "MIT",
    "shortDescription": "Veja o que ocupa o disco e libere espaço com segurança",
    "longDescription": "Barra de armazenamento no estilo iOS/Android para o Ubuntu: fotos, vídeos, áudio, documentos, apps/sistema e outros, com a Lixeira e o Docker. Nada é apagado direto: os arquivos vão para a Lixeira."
  },
  "mainBinaryName": "storage-looker"
}
